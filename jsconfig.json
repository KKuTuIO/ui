{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"noImplicitAny": false,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "esnext",
		"lib": ["esnext", "DOM", "DOM.Iterable"],
		"types": ["svelte"],
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src/**/*.js", "src/**/*.svelte"]
}
